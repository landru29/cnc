# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS build

ARG FLUIDNC_REF=v4.1.1
ARG PIO_ENV=noradio

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates build-essential \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir platformio

RUN git clone --depth 1 --branch ${FLUIDNC_REF} \
      https://github.com/bdring/FluidNC /fluidnc
WORKDIR /fluidnc

ARG PLATFORM_SPEC="espressif32@6.10.0"

RUN sed -i -E "s#^(\s*platform\s*=\s*).*platform-espressif32.*\$#\1${PLATFORM_SPEC}#" platformio.ini \
 && grep -n 'espressif32' platformio.ini \
 && pio run -e ${PIO_ENV}

RUN set -e; \
    mkdir /out; \
    B=.pio/build/${PIO_ENV}; \
    cp $B/bootloader.bin $B/partitions.bin $B/firmware.bin /out/; \
    cp /root/.platformio/packages/framework-arduinoespressif32/tools/partitions/boot_app0.bin /out/; \
    ls -l /out

FROM scratch AS artifacts
COPY --from=build /out/ /