{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CNC",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "rust: cargo build",
      "program": "${workspaceFolder}/target/debug/cnc",
      "args": ["-p", "/tmp/ttyESP32", "-l", "${workspaceFolder}/log.txt", "${workspaceFolder}/testdata/example.gcode"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "sourceLanguages": ["rust"],
      "initCommands": [
        "settings set target.disable-aslr false"
      ]
    }
  ]
}
